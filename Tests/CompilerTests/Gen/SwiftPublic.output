public struct InsertBarReturningExtraColumnOutput: Hashable, Sendable, RowDecodable {
    public let intPk: Int
    public let barNotNullText: String
    public let columnAfter: Int
    
    public static let nonOptionalIndices: [Int32] = []
    
    public init(
        row: borrowing PureSQL.Row,
        startingAt start: Int32
    ) throws(PureSQL.SQLError) {
        self.intPk = try row.value(at: start + 0)
