        self.textNullable = textNullable
        self.dateWithAdapterNotNull = dateWithAdapterNotNull
        self.dateWithAdapterNullable = dateWithAdapterNullable
        self.dateWithCustomAdapter = dateWithCustomAdapter
    }
}

